+	{ 0x00, 0x00, 0x00 },
+	{ 0x0000, 0x0000, 0x0000 },
+	{ 0x000, 0x3ff, 0x000, 0x3ff, 0x000, 0x3ff },
+	{ 0x000, 0x3ff, 0x000, 0x3ff, 0x000, 0x3ff },
