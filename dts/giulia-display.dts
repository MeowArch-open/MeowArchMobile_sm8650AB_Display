						reg = <0x03>;
						iommus = <0x4b 0x1003 0x80 0x4b 0x1043 0x20>;
						dma-coherent;
					};

					compute-cb@4 {
						compatible = "qcom,fastrpc-compute-cb";
						reg = <0x04>;
						iommus = <0x4b 0x1004 0x80 0x4b 0x1044 0x20>;
						dma-coherent;
