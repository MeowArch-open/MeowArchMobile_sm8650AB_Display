	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x08 0x00 0x01 0x0e 0x08 0x00 0x01 0x0b 0x08 0x00 0x01 0x0a 0x08 0x00>;
	};

	reboot-mode {
		compatible = "nvmem-reboot-mode";
		nvmem-cells = <0x147>;
		nvmem-cell-names = "reboot-mode";
		mode-recovery = <0x01>;
		mode-bootloader = <0x02>;
	};

	aliases {
		serial0 = "/soc@0/geniqup@8c0000/serial@89c000";
		serial1 = "/soc@0/geniqup@8c0000/serial@898000";
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <0x148>;

		key-volume-down {
			label = "Volume Down";
			linux,code = <0x72>;
			gpios = <0x10e 0x06 0x01>;
			debounce-interval = <0x0f>;
			linux,can-disable;
			wakeup-source;
		};
	};

	pmic-glink {
		compatible = "oplus,sm8650-pmic-glink", "qcom,sm8650-pmic-glink", "qcom,sm8550-pmic-glink", "qcom,pmic-glink";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		orientation-gpios = <0x73 0x1d 0x00>;
		oneplus,pps-read-buffer;
		oneplus,pps-fixed-5v;
		oneplus,pps-5v5-1a;
		oneplus,pps-ramp-9v-1a;
		oneplus,pps-ramp-9v2-1a;
		oneplus,pps-ramp-2to1-1a;
		oneplus,pps-run-2to1-5m;
		oneplus,pps-policy-2to1-1a;
		oneplus,pps-secondary-500ms;
		oneplus,pps-dual-500ms;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0x00>;
			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x149>;
						phandle = <0xe2>;
					};
				};

				port@2 {
					reg = <0x02>;

					endpoint {
						remote-endpoint = <0x14a>;
						phandle = <0x91>;
					};
				};
			};
		};
	};

	sound {
		compatible = "qcom,sm8650-sndcard", "qcom,sm8450-sndcard";
		model = "oneplus-giulia";
		pinctrl-names = "default";
		pinctrl-0 = <0x14b>;
		audio-routing = "IN1_HPHL", "HPHL_OUT", "IN2_HPHR", "HPHR_OUT", "AMIC1", "MIC BIAS1", "AMIC2", "MIC BIAS2", "AMIC3", "MIC BIAS3", "AMIC4", "MIC BIAS3", "AMIC5", "MIC BIAS4", "TX SWR_INPUT0", "ADC1_OUTPUT", "TX SWR_INPUT1", "ADC2_OUTPUT", "TX SWR_INPUT2", "ADC3_OUTPUT", "TX SWR_INPUT3", "ADC4_OUTPUT";

		wcd-playback-dai-link {
			link-name = "WCD Playback";

			cpu {
				sound-dai = <0x14c 0x71>;
			};

			codec {
				sound-dai = <0x14d 0x00 0x14e 0x00 0xd3 0x00>;
			};

			platform {
				sound-dai = <0x14f>;
			};
		};

		wcd-capture-dai-link {
			link-name = "WCD Capture";

			cpu {
				sound-dai = <0x14c 0x78>;
			};

			codec {
				sound-dai = <0x14d 0x01 0x150 0x00 0xd7 0x00>;
			};

			platform {
				sound-dai = <0x14f>;
			};
		};

		mi2s-dai-link {
			link-name = "MI2S Secondary Playback";

			cpu {
				sound-dai = <0x14c 0x12>;
			};

			platform {
				sound-dai = <0x14f>;
			};

			codec {
				sound-dai = <0x151 0x152>;
			};
		};
	};

	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <0x387520>;
		regulator-max-microvolt = <0x387520>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x123>;
	};

	audio-codec {
		compatible = "qcom,wcd9395-codec", "qcom,wcd9390-codec";
		pinctrl-names = "default";
		pinctrl-0 = <0x153>;
		qcom,micbias1-microvolt = <0x1b7740>;
		qcom,micbias2-microvolt = <0x1b7740>;
		qcom,micbias3-microvolt = <0x1b7740>;
		qcom,micbias4-microvolt = <0x1b7740>;
		qcom,mbhc-buttons-vthreshold-microvolt = <0x124f8 0x249f0 0x39dc8 0x7a120 0x7a120 0x7a120 0x7a120 0x7a120>;
		qcom,mbhc-headset-vthreshold-microvolt = <0x19f0a0>;
		qcom,mbhc-headphone-vthreshold-microvolt = <0xc350>;
		qcom,rx-device = <0x154>;
		qcom,tx-device = <0x155>;
		reset-gpios = <0x73 0x6b 0x01>;
		vdd-buck-supply = <0x90>;
		vdd-rxtx-supply = <0x90>;
		vdd-io-supply = <0x90>;
		vdd-mic-bias-supply = <0x124>;
		#sound-dai-cells = <0x01>;
		mode-switch;
		orientation-switch;
		phandle = <0x14d>;

		port {

			endpoint {
				remote-endpoint = <0x156>;
				phandle = <0x92>;
			};
		};
	};

	wcn7850-pmu {
		compatible = "qcom,wcn7850-pmu";
		pinctrl-names = "default";
		pinctrl-0 = <0x157 0x158>;
		wlan-enable-gpios = <0x73 0x10 0x00>;
		bt-enable-gpios = <0x73 0x11 0x00>;
		vdd-supply = <0x159>;
		vddio-supply = <0x90>;
		vddio1p2-supply = <0x15a>;
		vddaon-supply = <0x15b>;
		vdddig-supply = <0x128>;
		vddrfa1p2-supply = <0x125>;
		vddrfa1p8-supply = <0x126>;
		clocks = <0x02 0x06>;

		regulators {

			ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn";
				phandle = <0x68>;
			};

			ldo1 {
				regulator-name = "vreg_pmu_aon_0p59";
				phandle = <0x69>;
			};

			ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
				phandle = <0x6a>;
			};

			ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p85";
				phandle = <0x6b>;
			};

			ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p85";
			};

			ldo5 {
				regulator-name = "vreg_pmu_rfa_0p8";
				phandle = <0x6c>;
			};

			ldo6 {
				regulator-name = "vreg_pmu_rfa_1p2";
				phandle = <0x6d>;
			};

			ldo7 {
				regulator-name = "vreg_pmu_rfa_1p8";
				phandle = <0x6e>;
			};

			ldo8 {
				regulator-name = "vreg_pmu_pcie_0p9";
				phandle = <0xab>;
			};

			ldo9 {
				regulator-name = "vreg_pmu_pcie_1p8";
				phandle = <0xac>;
			};
		};
	};

	regulator-panel-vout {
		compatible = "regulator-fixed";
		regulator-name = "panel_vout";
		gpio = <0x73 0x5b 0x00>;
		enable-active-high;
		phandle = <0x104>;
	};

	regulator-ts-avdd {
		compatible = "regulator-fixed";
		regulator-name = "ts_avdd";
		regulator-min-microvolt = <0x2de600>;
		regulator-max-microvolt = <0x2de600>;
		gpio = <0x73 0x6c 0x00>;
		enable-active-high;
		phandle = <0x99>;
	};

	fingerprint {
		compatible = "goodix,gf3626";
		reset-gpios = <0x73 0x59 0x01>;
		vdd-supply = <0x15c>;
		firmware-name = "uff_spi";
		pinctrl-names = "default";
		pinctrl-0 = <0x15d>;
	};

	ak09970-slider {
		compatible = "oneplus,ak09970-slider";
		io-channels = <0x15e 0x00 0x15e 0x01 0x15e 0x02>;
		io-channel-names = "x", "y", "z";
		oneplus,up-threshold = <0x1388>;
		oneplus,mid-threshold = <0x55f0>;
		interrupt-parent = <0x73>;
		interrupts = <0x63 0x08>;
	};

	hypervisor {
		compatible = "qcom,gunyah-hypervisor", "gunyah-hypervisor", "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		gunyah-resource-mgr@831f2ab7189a43c1 {
			compatible = "gunyah-resource-manager";
			reg = <0x831f2ab7 0x189a43c1 0x831f2ab7 0x189a807c>;
			interrupts = <0x00 0x3a0 0x01 0x00 0x00 0x3a1 0x01 0x00>;
		};
	};
};
