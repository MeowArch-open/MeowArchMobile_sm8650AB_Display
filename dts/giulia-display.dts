		funnel@10042000 {
			compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
			reg = <0x00 0x10042000 0x00 0x1000>;
			clocks = <0xbc>;
			clock-names = "apb_pclk";

			in-ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@4 {
					reg = <0x04>;

					endpoint {
						remote-endpoint = <0x118>;
						phandle = <0x120>;
					};
				};
			};

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0x119>;
						phandle = <0x11a>;
					};
				};
			};
		};

		funnel@10045000 {
			compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
