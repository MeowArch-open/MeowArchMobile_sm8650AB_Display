/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "OnePlus Ace5";
	compatible = "oneplus,giulia", "qcom,sm8650";

	chosen {
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x493e000>;
			phandle = <0x121>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			phandle = <0x46>;
		};

		bi-tcxo-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0x00>;
			clocks = <0x02 0x00>;
			clock-mult = <0x01>;
			clock-div = <0x02>;
			phandle = <0x44>;
		};

		bi-tcxo-ao-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0x00>;
			clocks = <0x02 0x01>;
			clock-mult = <0x01>;
			clock-div = <0x02>;
			phandle = <0x45>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x00 0x00>;
			clocks = <0x03 0x00>;
			power-domains = <0x04>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <0x03 0x00>;
			operating-points-v2 = <0x06>;
			interconnects = <0x07 0x03 0x03 0x07 0x0f 0x03 0x08 0x00 0x03 0x08 0x01 0x03 0x09 0x00 0x09 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x1b>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x05>;

				l3-cache {
					compatible = "cache";
					cache-level = <0x03>;
					cache-unified;
					phandle = <0x0a>;
				};
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a520";
			reg = <0x00 0x100>;
			clocks = <0x03 0x00>;
			power-domains = <0x0b>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x05>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <0x03 0x00>;
			operating-points-v2 = <0x06>;
			interconnects = <0x07 0x03 0x03 0x07 0x0f 0x03 0x08 0x00 0x03 0x08 0x01 0x03 0x09 0x00 0x09 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x1c>;
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x00 0x200>;
			clocks = <0x03 0x03>;
			power-domains = <0x0c>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x0d>;
			capacity-dmips-mhz = <0x700>;
			dynamic-power-coefficient = <0xee>;
			qcom,freq-domain = <0x03 0x03>;
			operating-points-v2 = <0x0e>;
			interconnects = <0x07 0x03 0x03 0x07 0x0f 0x03 0x08 0x00 0x03 0x08 0x01 0x03 0x09 0x00 0x09 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x1d>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x0d>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x00 0x300>;
			clocks = <0x03 0x03>;
			power-domains = <0x0f>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x10>;
			capacity-dmips-mhz = <0x700>;
			dynamic-power-coefficient = <0xee>;
			qcom,freq-domain = <0x03 0x03>;
			operating-points-v2 = <0x0e>;
			interconnects = <0x07 0x03 0x03 0x07 0x0f 0x03 0x08 0x00 0x03 0x08 0x01 0x03 0x09 0x00 0x09 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x1e>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x10>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x00 0x400>;
			clocks = <0x03 0x03>;
			power-domains = <0x11>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x12>;
			capacity-dmips-mhz = <0x700>;
			dynamic-power-coefficient = <0xee>;
			qcom,freq-domain = <0x03 0x03>;
			operating-points-v2 = <0x0e>;
			interconnects = <0x07 0x03 0x03 0x07 0x0f 0x03 0x08 0x00 0x03 0x08 0x01 0x03 0x09 0x00 0x09 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x1f>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x12>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x00 0x500>;
			clocks = <0x03 0x01>;
			power-domains = <0x13>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x14>;
			capacity-dmips-mhz = <0x700>;
			dynamic-power-coefficient = <0xee>;
			qcom,freq-domain = <0x03 0x01>;
			operating-points-v2 = <0x15>;
			interconnects = <0x07 0x03 0x03 0x07 0x0f 0x03 0x08 0x00 0x03 0x08 0x01 0x03 0x09 0x00 0x09 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x20>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x14>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x00 0x600>;
			clocks = <0x03 0x01>;
			power-domains = <0x16>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x17>;
			capacity-dmips-mhz = <0x700>;
			dynamic-power-coefficient = <0xee>;
			qcom,freq-domain = <0x03 0x01>;
			operating-points-v2 = <0x15>;
			interconnects = <0x07 0x03 0x03 0x07 0x0f 0x03 0x08 0x00 0x03 0x08 0x01 0x03 0x09 0x00 0x09 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x21>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x17>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-x4";
			reg = <0x00 0x700>;
			clocks = <0x03 0x02>;
			power-domains = <0x18>;
			power-domain-names = "psci";
			enable-method = "psci";
			next-level-cache = <0x19>;
			capacity-dmips-mhz = <0x766>;
			dynamic-power-coefficient = <0x24c>;
			qcom,freq-domain = <0x03 0x02>;
			operating-points-v2 = <0x1a>;
			interconnects = <0x07 0x03 0x03 0x07 0x0f 0x03 0x08 0x00 0x03 0x08 0x01 0x03 0x09 0x00 0x09 0x01>;
			#cooling-cells = <0x02>;
			phandle = <0x22>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				next-level-cache = <0x0a>;
				phandle = <0x19>;
			};
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x1b>;
				};

				core1 {
					cpu = <0x1c>;
				};

				core2 {
					cpu = <0x1d>;
				};

				core3 {
					cpu = <0x1e>;
				};

				core4 {
					cpu = <0x1f>;
				};

				core5 {
					cpu = <0x20>;
				};

				core6 {
					cpu = <0x21>;
				};

				core7 {
					cpu = <0x22>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "silver-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x226>;
				exit-latency-us = <0x2ee>;
				min-residency-us = <0x1a2c>;
				local-timer-stop;
				phandle = <0x3d>;
			};

			cpu-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "gold-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x258>;
				exit-latency-us = <0x514>;
				min-residency-us = <0x1fc8>;
				local-timer-stop;
				phandle = <0x3e>;
			};

			cpu-sleep-2-0 {
				compatible = "arm,idle-state";
				idle-state-name = "gold-plus-rail-power-collapse";
				arm,psci-suspend-param = <0x40000004>;
				entry-latency-us = <0x1f4>;
				exit-latency-us = <0x546>;
				min-residency-us = <0x1d38>;
				local-timer-stop;
				phandle = <0x3f>;
			};
		};

		domain-idle-states {

			cluster-sleep-0 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x41000044>;
				entry-latency-us = <0x2ee>;
				exit-latency-us = <0x92e>;
				min-residency-us = <0x23b8>;
				phandle = <0x40>;
			};

			cluster-sleep-1 {
				compatible = "domain-idle-state";
				arm,psci-suspend-param = <0x4100c344>;
				entry-latency-us = <0xaf0>;
				exit-latency-us = <0x1130>;
				min-residency-us = <0x27a6>;
				phandle = <0x41>;
			};
		};
	};

	ete-0 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x1b>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x23>;
					phandle = <0x2b>;
				};
			};
		};
	};

	ete-1 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x1c>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x24>;
					phandle = <0x2c>;
				};
			};
		};
	};

	ete-2 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x1d>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x25>;
					phandle = <0x2d>;
				};
			};
		};
	};

	ete-3 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x1e>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x26>;
					phandle = <0x2e>;
				};
			};
		};
	};

	ete-4 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x1f>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x27>;
					phandle = <0x2f>;
				};
			};
		};
	};

	ete-5 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x20>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x28>;
					phandle = <0x30>;
				};
			};
		};
	};

	ete-6 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x21>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x29>;
					phandle = <0x31>;
				};
			};
		};
	};

	ete-7 {
		compatible = "arm,embedded-trace-extension";
		cpu = <0x22>;

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x2a>;
					phandle = <0x32>;
				};
			};
		};
	};

	funnel-ete {
		compatible = "arm,coresight-static-funnel";

		in-ports {
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			port@0 {
				reg = <0x00>;

				endpoint {
					remote-endpoint = <0x2b>;
					phandle = <0x23>;
				};
			};

			port@1 {
				reg = <0x01>;

				endpoint {
					remote-endpoint = <0x2c>;
					phandle = <0x24>;
				};
			};

			port@2 {
				reg = <0x02>;

				endpoint {
					remote-endpoint = <0x2d>;
					phandle = <0x25>;
				};
			};

			port@3 {
				reg = <0x03>;

				endpoint {
					remote-endpoint = <0x2e>;
					phandle = <0x26>;
				};
			};

			port@4 {
				reg = <0x04>;

				endpoint {
					remote-endpoint = <0x2f>;
					phandle = <0x27>;
				};
			};

			port@5 {
				reg = <0x05>;

				endpoint {
					remote-endpoint = <0x30>;
					phandle = <0x28>;
				};
			};

			port@6 {
				reg = <0x06>;

				endpoint {
					remote-endpoint = <0x31>;
					phandle = <0x29>;
				};
			};

			port@7 {
				reg = <0x07>;

				endpoint {
					remote-endpoint = <0x32>;
					phandle = <0x2a>;
				};
			};
		};

		out-ports {

			port {

				endpoint {
					remote-endpoint = <0x33>;
					phandle = <0x11f>;
				};
			};
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-sm8650", "qcom,scm";
			qcom,dload-mode = <0x34 0x19000>;
			interconnects = <0x35 0x02 0x07 0x08 0x01 0x07>;
		};
	};

	interconnect-0 {
		compatible = "qcom,sm8650-clk-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x36>;
		phandle = <0x4d>;
	};

	interconnect-1 {
		compatible = "qcom,sm8650-mc-virt";
		#interconnect-cells = <0x02>;
		qcom,bcm-voters = <0x36>;
		phandle = <0x08>;
	};

	opp-table-qup100mhz {
		compatible = "operating-points-v2";
		phandle = <0x53>;

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x37>;
		};

		opp-100000000 {
			opp-hz = <0x00 0x5f5e100>;
			required-opps = <0x38>;
		};
	};

	opp-table-qup120mhz {
		compatible = "operating-points-v2";
		phandle = <0x50>;

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x37>;
		};

		opp-120000000 {
			opp-hz = <0x00 0x7270e00>;
			required-opps = <0x38>;
		};
	};

	opp-table-qup128mhz {
		compatible = "operating-points-v2";
		phandle = <0x65>;

		opp-75000000 {
			opp-hz = <0x00 0x47868c0>;
			required-opps = <0x37>;
		};

		opp-128000000 {
			opp-hz = <0x00 0x7a12000>;
			required-opps = <0x38>;
		};
	};

	opp-table-qup240mhz {
		compatible = "operating-points-v2";
		phandle = <0x8b>;

		opp-150000000 {
			opp-hz = <0x00 0x8f0d180>;
			required-opps = <0x37>;
		};

		opp-240000000 {
			opp-hz = <0x00 0xe4e1c00>;
			required-opps = <0x38>;
		};
	};

	memory@a0000000 {
		device_type = "memory";
		reg = <0x00 0xa0000000 0x00 0x00>;
	};

	opp-table-cpu0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x06>;

		opp-307200000 {
			opp-hz = <0x00 0x124f8000>;
			opp-peak-kBps = <0x493e00 0x2162e0 0x960000>;
		};

